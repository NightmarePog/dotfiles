{
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "move_path": {
          "default": "allow"
        },
        "search_web": {
          "default": "allow"
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^cat\\b"
            }
          ]
        }
      }
    },
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "gpt-5.4",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "lsp": {
    "lazarus-lsp": {
      "binary": {
        "path": "lua",
        "arguments": ["/home/nightmare/Github/lazarus-lang/lazarus-lsp/Main.lua"],
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "jdtls": {
      "settings": {
        "java_home": "/usr/lib/jvm/java-21-openjdk",
      },
      "initialization_options": {
        "settings": {
          "java": {
            "launch": "hybrid",
            "configuration": {
              "updateBuildConfiguration": "automatic",
              "runtimes": [],
            },
            "saveActions": {
              "organizeImports": true,
            },
            "compile": {
              "nullAnalysis": {
                "mode": "automatic",
              },
            },
            "references": {
              "includeAccessors": true,
              "includeDecompiledSources": true,
            },
            "jdt": {
              "ls": {
                "lombokSupport": {
                  "enabled": true,
                },
                "protobufSupport": {
                  "enabled": true,
                },
                "javac": "off",
                "vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m -Xlog:disable",
              },
            },
            "eclipse": {
              "downloadSources": true,
            },
            "maven": {
              "downloadSources": true,
            },
            "gradle": {
              "downloadSources": true,
            },
            "autobuild": {
              "enabled": true,
            },
            "maxConcurrentBuilds": 1,
            "inlayhints": {
              "parameterNames": {
                "enabled": "all",
              },
            },
            "signatureHelp": {
              "enabled": true,
              "description": {
                "enabled": true,
              },
            },
            "format": {
              "enabled": true,
              "settings": {
                "url": "~/.config/jdtls/palantir_java_jdtls.xml",
              },
              "onType": {
                "enabled": true,
              },
            },
            "contentProvider": {
              "preferred": null,
            },
            "import": {
              "gradle": {
                "enabled": true,
              },
              "maven": {
                "enabled": true,
              },
              "exclusions": [
                "**/node_modules/**",
                "**/.metadata/**",
                "**/archetype-resources/**",
                "**/META-INF/maven/**",
              ],
            },
            "completion": {
              "enabled": true,
              "favoriteStaticMembers": [
                "org.junit.Assert.*",
                "org.junit.Assume.*",
                "org.junit.jupiter.api.Assertions.*",
                "org.junit.jupiter.api.Assumptions.*",
                "org.junit.jupiter.api.DynamicContainer.*",
                "org.junit.jupiter.api.DynamicTest.*",
                "org.mockito.Mockito.*",
                "org.mockito.ArgumentMatchers.*",
              ],
              "importOrder": ["java", "javax", "com", "org"],
              "postfix": {
                "enabled": true,
              },
              "chain": {
                "enabled": true,
              },
              "guessMethodArguments": "insertParameterNames",
            },
            "errors": {
              "incompleteClasspath": {
                "severity": "warning",
              },
            },
            "implementationsCodeLens": {
              "enabled": false,
            },
            "referencesCodeLens": {
              "enabled": false,
            },
          },
        },
      },
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Symbols Icon Theme",
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Catppuccin Espresso (Blur) [Light]",
  },
