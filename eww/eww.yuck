(include "eww_widgets.yuck")

(defwindow signalstrip
  :monitor '[0]'
  :stacking "bg"
  :exclusive false
  :focusable false
  :namespace "eww-signalstrip"
  :geometry (geometry
    :x "50"
    :y "50"
    :width "620px"
    :height "78px"
    :anchor "bottom right")
  (signalstrip)
)

(defwindow powermenu
  :monitor '[0]'
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-powermenu"
  :geometry (geometry
    :x "50"
    :y "50"
    :width "430px"
    :height "62px"
    :anchor "bottom right")
  (powermenu)
)

(defwindow osd
  :monitor '[0]'
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-osd"
  :geometry (geometry
    :x "0"
    :y "58"
    :width "290px"
    :height "76px"
    :anchor "bottom center")
  (osd)
)
