{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "margin-top": 12,
    "margin-right": 50,
    "margin-left": 50,

    "modules-left": ["custom/applauncher", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["network", "pulseaudio", "tray", "clock"],

    "custom/applauncher": {
        "format": "RUN",
        "on-click": "pgrep wofi >/dev/null 2>&1 && killall wofi || wofi --show drun --location=top -y 48",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "tooltip": false,
        "sort-by-number": true,
        "format": "{name}{windows}",
        "window-format": " {icon}",
        "window-rewrite-default": "󰣆",
        "window-rewrite": {
            "firefox": "󰈹",
            "kitty": "󰆍",
            "code": "󰨞",
            "code - oss": "󰨞",
            "vscodium": "󰨞",
            "dev.zed.Zed": "󰅩",
            "nautilus": "󰉋",
            "discord": "󰙯",
            "spotify": "󰓇",
            "steam": "󰓓",
            "vlc": "󰕼",
            "mpv": "󰕼",
            "obsidian": "󰂿",
            "telegram-desktop": "󰔁",
            "thunderbird": "󰇮",
            "blender": "󰂫",
            "pavucontrol": "󰕾"
        }
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 54,
        "tooltip": false,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "(.*) - VSCodium": "󰨞  $1",
            "(.*) - Code": "󰨞  $1",
            "(.*)": "$1"
        }
    },

    "network": {
        "format-wifi": "NET {bandwidthDownBits}",
        "format-ethernet": "NET {bandwidthDownBits}",
        "format-disconnected": "NET --",
        "interval": 5,
        "on-click": "nm-connection-editor",
        "tooltip": false
    },

    "pulseaudio": {
        "scroll-step": 5,
        "max-volume": 100,
        "format": "VOL {volume}%",
        "format-bluetooth": "VOL {volume}%",
        "format-muted": "VOL --",
        "on-click": "pavucontrol",
        "on-scroll-up": "/home/nightmare/.config/eww/scripts/osd.sh volume-up",
        "on-scroll-down": "/home/nightmare/.config/eww/scripts/osd.sh volume-down",
        "tooltip": false
    },

    "tray": {
        "spacing": 8,
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "on-click": "/home/nightmare/.config/eww/scripts/toggle_signalstrip.sh",
        "tooltip": false
    }
}
