{
    "layer": "top",
    "spacing": 10,
    "height": 0,
    "margin-bottom": 0,
    "margin-top": 15,
    "position": "top",
    "padding-right": 10,
    "margin-right": 50,
    "margin-left": 50,

    "modules-left": ["custom/applauncher", "hyprland/workspaces", "sway/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["network", "pulseaudio", "tray", "clock"],

    "custom/applauncher": {
        "format": "〇",
        "on-click": "pgrep wofi >/dev/null 2>&1 && killall wofi || wofi --show drun --location=top -y 15",
        "tooltip": false
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "tooltip": false,
        "format": "{name}{windows}",
        "window-format": " {icon}",
        "window-rewrite-default": "<span color='#555566'>󰣆</span>",
        "window-rewrite": {
            "firefox":           "<span color='#FF7722'>󰈹</span>",
            "Firefox":           "<span color='#FF7722'>󰈹</span>",
            "kitty":             "<span color='#6EC6A0'></span>",
